# Copy this file to .env and fill in your own values. Never commit the real .env file.
#
# Get TELEGRAM_API_ID and TELEGRAM_API_HASH from https://my.telegram.org
# -> API Development Tools -> create an app -> copy the "api_id" and "api_hash" shown.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Any name is fine -- this becomes the local session filename (data/<name>.session)
# which stores your logged-in Telegram session after you run scripts/telegram_login.py.
TELEGRAM_SESSION_NAME=signal_evaluator
